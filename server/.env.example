# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database Configuration (Render PostgreSQL or SQLite fallback)
# Example Render PostgreSQL URL: postgresql://username:password@hostname.render.com/dbname
DATABASE_URL=sqlite:///./portfolio.db

# GitHub API & Token Configuration
# Generate PAT at https://github.com/settings/tokens (scopes: repo, read:user)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_token_here

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key_here

# Target GitHub Account
GITHUB_USERNAME=MIHIRrPATIL

# Google Gemini Gen AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
