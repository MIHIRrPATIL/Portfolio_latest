      "id": "cdac-asr:product/backend/api/main.py:startup_event",
      "type": "FUNCTION",
      "name": "startup_event",
      "repo_id": "cdac-asr",
      "path": "product/backend/api/main.py",
      "signature": "async def startup_event()",
      "docstring": "",
      "code_snippet": "async def startup_event():\n    global engine\n    # Initialize connection to Prisma using centralized helper\n    from database import try_connect_db\n    await try_connect_db()\n        \n    # Safe fallback if environment variable isn't set\n    model_dir = os.getenv(\"ASR_MODEL_DIR\", \"MihirRPatil/nptel-asr-phoneme-v3\")\n    logger.info(f\"Loading ASR Engine with model from {model_dir}\")\n    try:\n        engine = ASREngine(model_dir=model_dir)\n        logger.info(\"ASR Engine successfully initialized.\")\n    except Exception as e:\n        logger.error(f\"Failed to load ASR engine: {e}\")",
      "start_line": 41,
      "end_line": 54,
